# Copy to .env.local and fill in. Never commit real values.

# Supabase — `npx supabase status` prints local values after `npx supabase start`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional LLM fallback (OFF by default) -------------------------------
# The bot is rule-based and works fully with LLM_ENABLED=false. Turn this on only to let a model
# help with free text nothing else understood. Provider-agnostic: any OpenAI-compatible endpoint.
# See MIGRATION_NOTES.md / README.md ("Optional LLM") for free-tier and local examples.
LLM_ENABLED=false
LLM_PROVIDER=none            # none | openrouter | openai_compatible (same thing)
LLM_BASE_URL=                # e.g. https://openrouter.ai/api/v1 · https://api.groq.com/openai/v1 · http://localhost:11434/v1
LLM_MODEL=                   # e.g. meta-llama/llama-3.3-70b-instruct:free · llama-3.1-8b-instant · qwen2.5:7b
LLM_API_KEY=                 # empty for local servers
LLM_JSON_MODE=true           # set false if the server rejects response_format
LLM_TIMEOUT_MS=4000
LLM_MAX_CALLS_PER_CONVERSATION_PER_DAY=30
LLM_MAX_CALLS_PER_CUSTOMER_PER_DAY=60
LLM_MAX_INPUT_CHARS=1500
LLM_CACHE_TTL_MS=86400000

# --- Bot tuning (all optional; defaults shown) -----------------------------
# BOT_MAX_REPROMPTS=2          BOT_FUZZY_THRESHOLD=0.8     BOT_FUZZY_MARGIN=0.1
# BOT_FAQ_MIN_SCORE=0.3        BOT_FAQ_MARGIN=0.1          BOT_UNKNOWN_STREAK_LIMIT=2
# BOT_NAME_MAX_TOKENS=5

# This app's own deployed base URL (no trailing slash) — used to build links
# the agent sends the customer, e.g. the document upload link.
APP_URL=http://localhost:3000

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# E.164, e.g. +230XXXXXXXX — where owner notifications/escalations are sent.
# Requires the owner to have messaged the business number in the last 24h,
# or an approved template outside that window (see /n8n/README.md).
OWNER_WHATSAPP_NUMBER=

# Shared secret n8n sends when calling /app/api route handlers
INTERNAL_API_SECRET=

# Owner dashboard (MVP): shared password + an existing staff_users.id for payments
DASHBOARD_PASSWORD=
STAFF_USER_ID=

# --- Demo mode (client demo without WhatsApp) — see docs/DEMO.md ---
# true enables /demo, /api/demo/*, the DEMO badge and stub WhatsApp sends.
DEMO_MODE=
