        "httpMethod": "POST",
        "path": "whatsapp-inbound",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "respond-200-immediately",
      "name": "Respond 200 Immediately",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [40, 120],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"received\" } }}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "has-messages",
      "name": "Has Messages",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [300, 120],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-messages-cond",
              "leftValue": "={{ $json.body.entry?.[0]?.changes?.[0]?.value?.messages }}",
              "rightValue": "",
              "operator": { "type": "array", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "normalize-inbound-message",
      "name": "Normalize Inbound Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 60],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const body = $input.item.json.body;\nconst change = body?.entry?.[0]?.changes?.[0]?.value;\nconst message = change?.messages?.[0];\n\nif (!message) {\n  throw new Error('Has Messages passed an item with no message[0] — check the IF condition upstream.');\n}\n\nconst from = message.from;\nconst messageId = message.id;\nconst timestamp = message.timestamp;\n\nlet type = message.type;\nlet text;\nlet replyId;\n\nif (message.type === 'interactive') {\n  const interactive = message.interactive;\n  if (interactive?.type === 'button_reply') {\n    type = 'button_reply';\n    replyId = interactive.button_reply.id;\n    text = interactive.button_reply.title;\n  } else if (interactive?.type === 'list_reply') {\n    type = 'list_reply';\n    replyId = interactive.list_reply.id;\n    text = interactive.list_reply.title;\n  } else {\n    type = 'text';\n    text = `[unsupported interactive type: ${interactive?.type}]`;\n  }\n} else if (message.type === 'text') {\n  type = 'text';\n  text = message.text?.body ?? '';\n} else if (message.type === 'image') {\n  type = 'image';\n  text = message.image?.caption ?? '';\n} else if (message.type === 'document') {\n  type = 'document';\n  text = message.document?.caption ?? '';\n} else if (message.type === 'location') {\n  type = 'location';\n  text = `${message.location?.latitude},${message.location?.longitude}`;\n} else {\n  // audio, video, sticker, contacts, reactions, unsupported/system message types.\n  type = 'text';\n  text = `[unsupported message type: ${message.type}]`;\n}\n\nreturn {\n  json: {\n    from,\n    messageId,\n    timestamp,\n    type,\n    text,\n    ...(replyId !== undefined ? { replyId } : {}),\n  },\n};"
      }
    },
    {
      "id": "call-backend",
      "name": "Call Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 60],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL }}/api/whatsapp/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-secret",
              "value": "={{ $env.INTERNAL_API_SECRET }}"
            },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
